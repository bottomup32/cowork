generator client {
  provider = "prisma-client"
  output   = "../src/generated"
}

datasource db {
  provider = "postgresql"
}

enum TeamRole {
  MEMBER
  SKILL_CREATOR
  TEAM_ADMIN
}

enum TaskStatus {
  OPEN
  COMPLETED
  CANCELLED
}

enum MessageRole {
  USER
  ASSISTANT
  SYSTEM
}

enum SkillVersionStatus {
  DRAFT
  TESTED
  REVIEW
  PUBLISHED
}

enum SkillReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id             String            @id @default(cuid())
  email          String            @unique
  displayName    String
  passwordHash   String
  memberships    TeamMembership[]
  projectMembers ProjectMember[]
  createdProjects Project[]        @relation("ProjectCreator")
  ownedTasks     Task[]            @relation("TaskOwner")
  conversations  Conversation[]
  createdSkills  Skill[]           @relation("SkillCreator")
  skillVersions  SkillVersion[]    @relation("SkillVersionCreator")
  skillTestRuns  SkillTestRun[]
  requestedSkillReviews SkillReview[] @relation("SkillReviewRequester")
  reviewedSkillReviews  SkillReview[] @relation("SkillReviewReviewer")
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
}

model Team {
  id          String           @id @default(cuid())
  name        String
  memberships TeamMembership[]
  projects    Project[]
  skills      Skill[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model Skill {
  id              String        @id @default(cuid())
  teamId          String
  createdById     String
  name            String
  activeVersionId String?       @unique
  disabledAt      DateTime?
  team            Team          @relation(fields: [teamId], references: [id], onDelete: Cascade)
  createdBy       User          @relation("SkillCreator", fields: [createdById], references: [id])
  versions        SkillVersion[] @relation("SkillVersions")
  activeVersion   SkillVersion? @relation("ActiveSkillVersion", fields: [activeVersionId], references: [id], onDelete: SetNull)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([teamId, updatedAt])
  @@index([createdById, updatedAt])
}

model SkillVersion {
  id              String             @id @default(cuid())
  skillId         String
  createdById     String
  version         Int
  status          SkillVersionStatus @default(DRAFT)
  definition      Json
  changeNote      String             @db.Text
  skill           Skill              @relation("SkillVersions", fields: [skillId], references: [id], onDelete: Cascade)
  createdBy       User               @relation("SkillVersionCreator", fields: [createdById], references: [id])
  activeForSkills Skill[]            @relation("ActiveSkillVersion")
  testRuns        SkillTestRun[]
  reviews         SkillReview[]
  createdAt       DateTime           @default(now())

  @@unique([skillId, version])
  @@index([skillId, createdAt])
}

model SkillTestRun {
  id             String       @id @default(cuid())
  skillVersionId String
  createdById    String
  passed         Boolean
  result         Json
  skillVersion   SkillVersion @relation(fields: [skillVersionId], references: [id], onDelete: Cascade)
  createdBy      User         @relation(fields: [createdById], references: [id])
  createdAt      DateTime     @default(now())

  @@index([skillVersionId, createdAt])
}

model SkillReview {
  id             String            @id @default(cuid())
  skillVersionId String
  requestedById  String
  reviewedById   String?
  status         SkillReviewStatus @default(PENDING)
  note           String?           @db.Text
  skillVersion   SkillVersion      @relation(fields: [skillVersionId], references: [id], onDelete: Cascade)
  requestedBy    User              @relation("SkillReviewRequester", fields: [requestedById], references: [id])
  reviewedBy     User?             @relation("SkillReviewReviewer", fields: [reviewedById], references: [id])
  createdAt      DateTime          @default(now())
  reviewedAt     DateTime?

  @@index([skillVersionId, status])
}

model TeamMembership {
  teamId    String
  userId    String
  role      TeamRole @default(MEMBER)
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([teamId, userId])
  @@index([userId, teamId])
}

model Project {
  id          String          @id @default(cuid())
  teamId      String
  createdById String
  name        String
  team        Team            @relation(fields: [teamId], references: [id], onDelete: Cascade)
  createdBy   User            @relation("ProjectCreator", fields: [createdById], references: [id])
  members     ProjectMember[]
  tasks       Task[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([teamId])
}

model ProjectMember {
  projectId String
  userId    String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([projectId, userId])
  @@index([userId, projectId])
}

model Task {
  id           String       @id @default(cuid())
  projectId    String
  ownerId      String
  title        String
  status       TaskStatus   @default(OPEN)
  project      Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  owner        User         @relation("TaskOwner", fields: [ownerId], references: [id])
  conversation Conversation?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([projectId, ownerId])
}

model Conversation {
  id        String    @id @default(cuid())
  taskId    String    @unique
  userId    String
  task      Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id])
  messages  Message[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([userId])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  role           MessageRole
  content        String       @db.Text
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
}
