{
  "name": "team-cowork",
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "node --test tests/repo-structure.test.mjs tests/config/e2e-database-url.test.mjs && turbo run test",
    "test:e2e": "playwright test",
    "format": "prettier --write .",
    "db:generate": "pnpm --filter @cowork/db db:generate",
    "db:migrate": "pnpm --filter @cowork/db db:migrate",
    "db:seed": "pnpm --filter @cowork/db db:seed"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.55.0",
    "@types/node": "^22.0.0",
    "dotenv": "^17.4.2",
    "exceljs": "^4.4.0",
    "prettier": "^3.0.0",
    "turbo": "^2.0.0",
    "typescript": "^5.0.0",
    "vitest": "^3.0.0"
  }
}
